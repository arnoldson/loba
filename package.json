{
  "name": "loba",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@loba/mobile",
    "mobile:prod": "npm run start:prod --workspace=@loba/mobile",
    "backend": "npm run dev --workspace=@loba/backend",
    "backend:build": "npm run build --workspace=@loba/backend",
    "prepare": "husky || true",
    "test:backend": "npm test --workspace=@loba/backend",
    "e2e": "apps/mobile/.maestro/e2e.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    }
  }
}
